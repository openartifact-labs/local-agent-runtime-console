API_HOST=127.0.0.1
API_PORT=4318
WEB_ORIGIN=http://127.0.0.1:4317
LOG_LEVEL=info
DATABASE_PATH=.runtime/data/runtime-console.sqlite
CODEX_BIN=codex
CODEX_REQUEST_TIMEOUT_MS=30000
CODEX_RECONNECT_BASE_DELAY_MS=500
CODEX_RECONNECT_MAX_DELAY_MS=30000
CODEX_SYNC_INTERVAL_MS=5000
CODEX_STALE_AFTER_MS=180000
CODEX_LIST_PAGE_SIZE=100
CODEX_LIST_MAX_PAGES=100

# Web 构建变量；开发时可写入 apps/web/.env.local，桌面生产包使用同源 API。
VITE_API_BASE_URL=/api
